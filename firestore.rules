rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // One danmaku. Anyone can read; anyone can add a well-formed one; nobody can edit or delete.
    match /danmu/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['videoId', 't', 'text', 'source', 'createdAt', 'color', 'mode'])
        && request.resource.data.keys().hasAll(['videoId', 't', 'text', 'source', 'createdAt'])
        && request.resource.data.videoId is string
        && request.resource.data.videoId.matches('^[A-Za-z0-9_-]{11}$')
        && request.resource.data.t is number
        && request.resource.data.t >= 0
        && request.resource.data.t < 86400
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 100
        // Only danmaku sent through the extension are stored; comment danmaku are fetched live.
        && request.resource.data.source == 'user'
        && request.resource.data.createdAt == request.time
        // Optional, chosen by the sender: colour as #RRGGBB, and scrolling or fixed at the top/bottom.
        && (!('color' in request.resource.data) || request.resource.data.color.matches('^#[0-9A-Fa-f]{6}$'))
        && (!('mode' in request.resource.data) || request.resource.data.mode in ['scroll', 'top', 'bottom']);
      allow update, delete: if false;
    }

    // Old seeding claims (comment danmaku are no longer stored). Read-only.
    match /videos/{videoId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
